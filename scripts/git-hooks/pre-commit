#!/bin/sh
# proofbundle pre-commit hook. Two checks, both EARLY rather than thorough; the thorough version
# runs in CI and stays the gate there.
#
# 1. Mutation signatures on staged security paths (incident 2026-07-23: a probe's `if False:` at
#    the SD-JWT key-binding check survived into the working tree). A legitimate exception needs a
#    VISIBLE `# mutant-guard: allow` comment on or directly above the flagged line.
#
# 2. The MANIFEST decision for new files under scripts/, new on 2026-09-14, and the reason is
#    measured. Since the owner decision of 2026-09-06, MANIFEST.in requires a decision PER FILE,
#    and the guard for it sat at the end of a full-suite job of 22 to 42 minutes. In one evening
#    THREE branches failed on it, nine CI jobs together, to learn ONE line each. The guard was
#    never wrong, it was too late. Here the same answer costs seconds.
#
#    NO SECOND PRODUCER (OA-714de2fcdd): the hook calls EXACTLY the node that CI runs. Two tools
#    for one question drift apart; this is the same tool, asked earlier.
#
#    ONLY WHEN scripts/ IS TOUCHED, otherwise the hook costs every commit the pytest start-up time.
#
# Install with: sh scripts/install_git_hooks.sh
# CI runs both checks over the push or PR range, so skipping this hook locally does not skip the
# check.
set -e
ROOT="$(git rev-parse --show-toplevel)"

python3 "$ROOT/scripts/mutant_signature_guard.py" --staged

if git diff --cached --name-only --diff-filter=ACMR | grep -q '^scripts/'; then
    # FAIL-OPEN ONLY WHEN THE TOOL IS MISSING, and visibly: a developer without pytest should not
    # be kept from committing, but should not believe it was checked either. The gate stays CI;
    # this hook is the early warning, not the decision.
    if PYTHONPATH="$ROOT/src" python3 -c "import pytest" 2>/dev/null; then
        PYTHONPATH="$ROOT/src" python3 -m pytest \
            "$ROOT/tests/test_sdist_ohne_signierwerkzeug.py::test_jede_datei_unter_scripts_ist_in_manifest_entschieden" \
            -q -p no:cacheprovider --no-header
    else
        echo "pre-commit: pytest is missing, the MANIFEST decision was NOT checked (CI checks it)" >&2
    fi
fi
